#!/bin/sh
# PXD Host (.pxd2 installer) for a Raspberry Pi 5 or any Debian/Ubuntu box. Run:  sh PXD-Host-Pi.pxd2 [host-id]
set -e
T=$(mktemp -d)
sed '1,/^__PXD2_PAYLOAD__$/d' "$0" | base64 -d | tar -xz -C "$T"
sh "$T/pxdhost-install.sh" "${1:-pi1}"
rm -rf "$T"
exit 0
