#!/bin/sh
# PXD Web for Linux (.pxd2 installer). Run:  sh PXD-Web-Linux.pxd2
# Unpacks to a temporary folder, installs to /opt/pxd-web, adds PXD Web ON / OFF / STATUS to the desktop, turns it on.
set -e
T=$(mktemp -d)
sed '1,/^__PXD2_PAYLOAD__$/d' "$0" | base64 -d | tar -xz -C "$T"
sh "$T/linux/pxdweb.sh" install "$(id -un)"
rm -rf "$T"
exit 0
